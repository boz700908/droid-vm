# SukiSU Ultra（KSU fork）出 kernelsu.ko 的前提，只放上游没覆盖的项。
# 注意：CONFIG_KSU / CONFIG_KPM 不写在这里 —— SukiSU 的 Kconfig 没挂进本树，
# 这两个值在编译 .ko 时用 make 变量传：CONFIG_KSU=m CONFIG_KPM=y

## 模块加载（LKM 本体）
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODULE_FORCE_UNLOAD=y
# 不开 MODVERSIONS：.ko 必须与内核成对编译，CRC 只增加编译期麻烦
CONFIG_MODVERSIONS=n
# 不强制模块签名（模块我们自编）
CONFIG_MODULE_SIG=n
CONFIG_MODULE_SIG_FORCE=n

## KSU/KPM 的运行时符号解析 + inline hook
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y
CONFIG_KPROBES=y

## KSU 的 "depends on KPROBES && EXT4_FS" 的另一半；
## EXT4_FS_POSIX_ACL/SECURITY 在 docker.config 里已开，主体这里显式给
CONFIG_EXT4_FS=y
CONFIG_OVERLAY_FS=y

## SELinux：Magisk 的 magiskpolicy live patch 与 Android init 都需要。
## 上游 android-guest.config / docker.config 完全没有这一段，UML 上能否编过待实测，
## 出问题时单独摘掉这整段再试。
CONFIG_SECURITY=y
CONFIG_SECURITYFS=y
CONFIG_AUDIT=y
CONFIG_AUDIT_WATCH=y
CONFIG_AUDIT_TREE=y
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_SELINUX_BOOTPARAM=y
CONFIG_SECURITY_SELINUX_DEVELOP=y
CONFIG_SECURITY_SELINUX_AVC_STATS=y
CONFIG_LSM="landlock,lockdown,yama,selinux,bpf"
