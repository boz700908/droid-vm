# SukiSU Ultra 走 LKM（CONFIG_KSU=m）+ 内建 KPM（CONFIG_KPM=y）所需的内核侧支撑。
#
# 注意：CONFIG_KSU / CONFIG_KPM 不写进 .config —— 上游树的 Kconfig 里没有这两个符号，
# 它们是在编译 kernelsu.ko 时用 make 变量传进去的（obj-$(CONFIG_KSU) 照样生效）：
#   make -C <ksrc> O=<objtree> ARCH=um SUBARCH=arm64 LLVM=1 M=<sukisu>/kernel \
#        CONFIG_KSU=m CONFIG_KPM=y modules
#
# 本片段按「一个标准 Android 内核该有的能力」写全，而不是只开 KSU 用到的几项：
# 后面加子系统不至于一个个回来补，也避免 KSU/Magisk 的模块脚本踩到缺功能就失败。
# 不存在的符号会被 olddefconfig 丢掉，写多了不致命。

# ---------------------------------------------------------------- 模块装载（KSU 前提）
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODULE_FORCE_UNLOAD=y
CONFIG_MODULE_COMPRESS_NONE=y
# 我们自编自用：不要版本戳（否则 kernelsu.ko 与内核必须逐字节同源），也不要签名
# CONFIG_MODVERSIONS is not set
# CONFIG_MODULE_SIG is not set
# CONFIG_MODULE_SIG_FORCE is not set
CONFIG_MODULE_ALLOW_BTF_MISMATCH=y
CONFIG_ASM_MODVERSIONS=y

# ---------------------------------------------------------------- 符号与探针（KSU 的 hook）
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y
CONFIG_KRETPROBES=y
CONFIG_UPROBES=y
CONFIG_FTRACE=y
CONFIG_FUNCTION_TRACER=y
CONFIG_STACKTRACE=y
CONFIG_FRAME_POINTER=y
CONFIG_DEBUG_INFO=n
# SukiSU 的 lkm_image 能读 /sys/kernel/btf/vmlinux 按 BTF 解析符号；没有也能走 kallsyms，
# 但开了 BTF 更稳（CI 需要 pahole）。先关着，等 lkm_image 真报缺符号再开。
# CONFIG_DEBUG_INFO_BTF is not set

# ---------------------------------------------------------------- 文件系统
CONFIG_EXT4_FS=y
CONFIG_EXT4_USE_FOR_EXT2=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_JBD2=y
CONFIG_FS_MBCACHE=y
# F2FS 在 ARCH=um 下 f2fs_rwsem 结构不兼容，关闭
# CONFIG_F2FS_FS is not set
CONFIG_OVERLAY_FS=y
CONFIG_OVERLAY_FS_REDIRECT_DIR=y
CONFIG_OVERLAY_FS_INDEX=y
CONFIG_OVERLAY_FS_METACOPY=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_SQUASHFS_LZ4=y
CONFIG_SQUASHFS_LZO=y
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_ZIP_LZMA=y
CONFIG_EROFS_FS_ZIP_ZSTD=y
CONFIG_FUSE_FS=y
CONFIG_VIRTIO_FS=n
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_VFAT_FS=y
CONFIG_EXFAT_FS=y
CONFIG_MSDOS_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
CONFIG_ISO9660_FS=y
CONFIG_UDF_FS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_CONFIGFS_FS=y
CONFIG_DEBUG_FS=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_QUOTA=y
CONFIG_QFMT_V2=y

# ---------------------------------------------------------------- 容器 / 命名空间 / 资源控制
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_USER_NS=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CPUSETS=y
CONFIG_MEMCG=y
CONFIG_MEMCG_SWAP=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_BPF=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_POSIX_MQUEUE=y
CONFIG_KEYS=y
CONFIG_SWAP=y
CONFIG_ZRAM=y
CONFIG_ZSMALLOC=y

# ---------------------------------------------------------------- 网络（Magisk/KSU 模块与容器常依赖）
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_PACKET=y
CONFIG_NETFILTER=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_NF_TABLES=y
CONFIG_NFT_COMPAT=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_MANGLE=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP_NF_TARGET_REJECT=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_MANGLE=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_MATCH_CONNMARK=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
CONFIG_NETFILTER_XT_MATCH_OWNER=y
CONFIG_NETFILTER_XT_MATCH_PKTTYPE=y
CONFIG_NETFILTER_XT_MATCH_STATE=y
CONFIG_NETFILTER_XT_TARGET_TCPMSS=y
CONFIG_BRIDGE=y
CONFIG_VETH=y
CONFIG_TUN=y
CONFIG_DUMMY=y
CONFIG_VLAN_8021Q=y
CONFIG_MACVLAN=y
CONFIG_NET_SCHED=y
CONFIG_NET_CLS_BASIC=y
CONFIG_NET_CLS_U32=y
CONFIG_NET_ACT_MIRRED=y
CONFIG_NETLINK_DIAG=y
CONFIG_INET_DIAG=y

# ---------------------------------------------------------------- Android 专用
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"
CONFIG_PSI=y
CONFIG_ASHMEM=n
CONFIG_DMA_SHARED_BUFFER=y
CONFIG_DMABUF_HEAPS=y
CONFIG_ANDROID_VENDOR_HOOKS=y

# ---------------------------------------------------------------- 安全 / SELinux（Magisk 的 magiskpolicy --live 依赖）
CONFIG_SECURITY=y
CONFIG_SECURITYFS=y
CONFIG_SECURITY_NETWORK=y
CONFIG_SECURITY_PATH=y
CONFIG_AUDIT=y
CONFIG_AUDITSYSCALL=y
CONFIG_AUDIT_WATCH=y
CONFIG_AUDIT_TREE=y
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_SELINUX_BOOTPARAM=y
CONFIG_SECURITY_SELINUX_DEVELOP=y
CONFIG_SECURITY_SELINUX_AVC_STATS=y
CONFIG_SECURITY_SELINUX_SIDTAB_HASH_BITS=9
CONFIG_SECURITY_YAMA=y
CONFIG_LSM="landlock,lockdown,yama,selinux,bpf"
CONFIG_FANOTIFY=y
CONFIG_FANOTIFY_ACCESS_PERMISSIONS=y
CONFIG_INOTIFY_USER=y

# ---------------------------------------------------------------- 常规 syscall / 现代 Android 用户态需要
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_AIO=y
CONFIG_FUTEX=y
CONFIG_MEMFD_CREATE=y
CONFIG_KCMP=y
CONFIG_CHECKPOINT_RESTORE=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_ELF_CORE=y
CONFIG_COREDUMP=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_BINFMT_MISC=y
CONFIG_RSEQ=y

# ---------------------------------------------------------------- 块设备 / 加密 / 更多文件系统
CONFIG_BLK_DEV_DM=y
CONFIG_DM_CRYPT=y
CONFIG_DM_VERITY=y
CONFIG_DM_SNAPSHOT=y
CONFIG_DM_THIN_PROVISIONING=y
CONFIG_MD=y
CONFIG_BLK_DEV_MD=y
CONFIG_MD_RAID0=y
CONFIG_MD_RAID1=y
CONFIG_BTRFS_FS=y
CONFIG_BTRFS_FS_POSIX_ACL=y
CONFIG_XFS_FS=y
CONFIG_CRYPTO_USER_API=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
CONFIG_CRYPTO_LZ4=y
CONFIG_CRYPTO_ZSTD=y
CONFIG_CRYPTO_XTS=y
CONFIG_CRYPTO_CTS=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_SHA512=y

# ---------------------------------------------------------------- 网络 / BPF 扩展
CONFIG_NET_IPIP=y
CONFIG_NET_IPGRE=y
CONFIG_NET_UDP_TUNNEL=y
CONFIG_INET_TUNNEL=y
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_CT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_NAT=y
CONFIG_NFT_REJECT=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_UNPRIV_DEFAULT_OFF=n
CONFIG_VSOCKETS=n
CONFIG_VIRTIO_VSOCKETS=n
CONFIG_KPROBES=y
CONFIG_KRETPROBES=y
CONFIG_WERROR=n

# ---------------------------------------------------------------- 事件跟踪（binder 的硬依赖）
# ANDROID_BINDER_IPC depends on MMU && NET && EVENT_TRACING：
# 少了 EVENT_TRACING，binder 三个符号会被 Kconfig 直接从 .config 里剔掉，而不是置 n。
CONFIG_TRACING=y
CONFIG_EVENT_TRACING=y
CONFIG_KPROBE_EVENTS=y

# ---------------------------------------------------------------- 容器 / 网络补缺
CONFIG_NET_CLS_ACT=y
CONFIG_NET_ACT_MIRRED=y
CONFIG_NET_SCH_HTB=y
CONFIG_NET_SCH_INGRESS=y
CONFIG_NET_CLS_FW=y
CONFIG_BLK_DEV_THROTTLING=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_NETFILTER_XT_MATCH_BPF=y
CONFIG_NETFILTER_XT_TARGET_CT=y
CONFIG_CRYPTO_USER=y

# UML 无 FUNCTION_TRACER，靠 syscall tracers 把隐藏的 TRACING/EVENT_TRACING select 起来（binder 依赖）
CONFIG_FTRACE_SYSCALLS=y
CONFIG_GENERIC_TRACER=y
