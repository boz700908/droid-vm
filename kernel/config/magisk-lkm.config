# 我们自己追加的片段：模块加载 + 符号 + kprobe
# Magisk 的模块本体是 overlayfs 挂载（在 android-guest.config / docker.config 里已开），
# 但「内核能加载 .ko」是 KernelSU LKM 与第三方模块的唯一前提，必须在。
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODULE_FORCE_UNLOAD=y
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y
CONFIG_KPROBES=y
# 我们自己编模块、自己发，不需要按 GKI 符号表校验
# CONFIG_MODVERSIONS is not set
