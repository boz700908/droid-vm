# 「一台手机该有的东西」里，能在 UML 上没有硬件也先立起来的那些。
# 原则：内核侧能给的先给全，用户态 HAL 我们自己写（见 docs/devices.md）。
# 每条都是在没有任何真实外设的前提下，凭空造出设备节点。

# ---- 电池 / 充电 ----
# Android 的 health HAL 读 /sys/class/power_supply；test_power 造一块假电池，
# 电量、充电状态都可写，Settings 里的电池页和电量告警才有东西可读。
CONFIG_POWER_SUPPLY=y
CONFIG_TEST_POWER=y

# ---- 摄像头 ----
# vivid 是 V4L2 的虚拟采集驱动，直接产出 /dev/video*，画面是内核生成的测试图。
# 配上 AOSP 的 external camera HAL 就是一个「能用」的摄像头。
CONFIG_MEDIA_SUPPORT=y
CONFIG_MEDIA_CAMERA_SUPPORT=y
CONFIG_MEDIA_CONTROLLER=y
CONFIG_VIDEO_DEV=y
CONFIG_VIDEO_V4L2=y
CONFIG_VIDEOBUF2_VMALLOC=y
CONFIG_V4L2_FWNODE=y
CONFIG_V4L_MEM2MEM_DRIVERS=y
CONFIG_VIDEO_VIVID=y

# ---- 传感器 / 输入 ----
# IIO 是 Android 传感器 HAL 最常见的底层；软设备由 configfs 现场造，
# 加速度、陀螺、磁力、光照、气压都可以按这个口子灌进去。
CONFIG_IIO=y
CONFIG_IIO_BUFFER=y
CONFIG_IIO_TRIGGER=y
CONFIG_IIO_SW_DEVICE=y
CONFIG_IIO_SW_TRIGGER=y
# 振动的力反馈事件走 input 子系统。
CONFIG_INPUT_FF_MEMLESS=y

# ---- 无线 ----
# hwsim 在纯软件里造出 mac80211 无线设备，不需要任何真实射频；
# Android 的 wifi HAL 是我们后面要写的那一层。
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_MAC80211_HWSIM=y
# hci_vhci 给出 /dev/vhci，可以在软件里挂一个蓝牙控制器；
# Android 的蓝牙协议栈通过 HCI 口跟它说话。
CONFIG_BT=y
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_HCIVHCI=y

# ---- 温度 / 灯 ----
# Android 的热管理 HAL 读 thermal zone；没有真实传感器也能造一块可写的。
CONFIG_THERMAL=y
CONFIG_THERMAL_WRITABLE_TRIPS=y
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
