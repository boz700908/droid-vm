# redroid 在 UML 里跑起来需要的两处补充。
#
# DMABUF_HEAPS_SYSTEM：gralloc 与软件渲染（gpu_mode=guest）在这里分配缓冲区。
# 上游 android-guest.config 只开了 DMABUF_HEAPS，system heap 这个叶子没开，
# 结果 surfaceflinger 会因为申请不到 dmabuf 直接起不来。
CONFIG_DMABUF_HEAPS_SYSTEM=y
# SW_SYNC：软件渲染的 fence 时间线，Android 的显示管线无条件要用它。
CONFIG_SW_SYNC=y
# 调试用：/sys/kernel/dmabuf 下能看到每块缓冲区的分配者，泄漏时用来定位。
CONFIG_DMABUF_SYSFS_STATS=y
