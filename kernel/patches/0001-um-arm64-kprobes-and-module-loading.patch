+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * ARCH=um SUBARCH=arm64 的 <asm/traps.h>。
+ *
+ * 父架构的这份头只被 kernel/probes/{kprobes,simulate-insn}.c 包含，而这两个文件
+ * 并不使用它里面的任何东西。真头却会经 <asm/esr.h> 把 <asm/memory.h> 拉进来，
+ * 那份头依赖 CONFIG_ARM64_VA_BITS、virt_to_phys、__ro_after_init 等只对真 arm64
+ * 成立的前提，在 UML 上必然编不过。所以这里给一个空壳。
+ */
+#ifndef __UM_ARM64_TRAPS_H
+#define __UM_ARM64_TRAPS_H
+
+#include <asm/ptrace.h>
+
+/*
+ * 父架构把它实现为 kernel/traps.c 里的真函数（要处理 compat 与 PC 前进量）。
+ * UML 侧只有 aarch64 语义：把 PC 推进一条被模拟掉的指令即可。
+ */
+#define arm64_skip_faulting_instruction(regs, size)	(PT_REGS_IP(regs) += (size))
+
+#endif /* __UM_ARM64_TRAPS_H */
diff --git a/arch/arm64/um/kprobe-cond.c b/arch/arm64/um/kprobe-cond.c
new file mode 100644
index 000000000..4dbf7cf5b
--- /dev/null
+++ b/arch/arm64/um/kprobe-cond.c
@@ -0,0 +1,107 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * A32 条件执行谓词表（ARCH=um SUBARCH=arm64）。
+ *
+ * simulate-insn.c 解码到 A32 指令时要先按 NZCV 判断这条指令是否执行，父架构把
+ * 这张表放在 arch/arm64/kernel/traps.c，而 UML 不编那个文件，于是 vmlinux 链接
+ * 时会缺 aarch32_opcode_cond_checks。这里按 ARM ARM 的条件码定义给出等价实现，
+ * 语义逐条照抄父架构（含 cc 0b1111 与 0b1110 等价于 AL 的处理）。
+ */
+#include <linux/kprobes.h>
+#include <linux/types.h>
+#include <asm/insn.h>
+#include <asm/ptrace.h>
+
+static bool __kprobes um_cond_eq(unsigned long pstate)
+{
+	return (pstate & PSR_Z_BIT) != 0;
+}
+
+static bool __kprobes um_cond_ne(unsigned long pstate)
+{
+	return (pstate & PSR_Z_BIT) == 0;
+}
+
+static bool __kprobes um_cond_cs(unsigned long pstate)
+{
+	return (pstate & PSR_C_BIT) != 0;
+}
+
+static bool __kprobes um_cond_cc(unsigned long pstate)
+{
+	return (pstate & PSR_C_BIT) == 0;
+}
+
+static bool __kprobes um_cond_mi(unsigned long pstate)
+{
+	return (pstate & PSR_N_BIT) != 0;
+}
+
+static bool __kprobes um_cond_pl(unsigned long pstate)
+{
+	return (pstate & PSR_N_BIT) == 0;
+}
+
+static bool __kprobes um_cond_vs(unsigned long pstate)
+{
+	return (pstate & PSR_V_BIT) != 0;
+}
+
+static bool __kprobes um_cond_vc(unsigned long pstate)
+{
+	return (pstate & PSR_V_BIT) == 0;
+}
+
+static bool __kprobes um_cond_hi(unsigned long pstate)
+{
+	pstate &= ~(pstate >> 1);	/* PSR_C_BIT &= ~PSR_Z_BIT */
+	return (pstate & PSR_C_BIT) != 0;
+}
+
+static bool __kprobes um_cond_ls(unsigned long pstate)
+{
+	pstate &= ~(pstate >> 1);	/* PSR_C_BIT &= ~PSR_Z_BIT */
+	return (pstate & PSR_C_BIT) == 0;
+}
+
+static bool __kprobes um_cond_ge(unsigned long pstate)
+{
+	pstate ^= (pstate << 3);	/* PSR_N_BIT ^= PSR_V_BIT */
+	return (pstate & PSR_N_BIT) == 0;
+}
+
+static bool __kprobes um_cond_lt(unsigned long pstate)
+{
+	pstate ^= (pstate << 3);	/* PSR_N_BIT ^= PSR_V_BIT */
+	return (pstate & PSR_N_BIT) != 0;
+}
+
+static bool __kprobes um_cond_gt(unsigned long pstate)
+{
+	/* PSR_N_BIT ^= PSR_V_BIT */
+	unsigned long temp = pstate ^ (pstate << 3);
+
+	temp |= (pstate << 1);		/* PSR_N_BIT |= PSR_Z_BIT */
+	return (temp & PSR_N_BIT) == 0;
+}
+
+static bool __kprobes um_cond_le(unsigned long pstate)
+{
+	/* PSR_N_BIT ^= PSR_V_BIT */
+	unsigned long temp = pstate ^ (pstate << 3);
+
+	temp |= (pstate << 1);		/* PSR_N_BIT |= PSR_Z_BIT */
+	return (temp & PSR_N_BIT) != 0;
+}
+
+static bool __kprobes um_cond_al(unsigned long pstate)
+{
+	return true;
+}
+
+pstate_check_t * const aarch32_opcode_cond_checks[16] = {
+	um_cond_eq, um_cond_ne, um_cond_cs, um_cond_cc,
+	um_cond_mi, um_cond_pl, um_cond_vs, um_cond_vc,
+	um_cond_hi, um_cond_ls, um_cond_ge, um_cond_lt,
+	um_cond_gt, um_cond_le, um_cond_al, um_cond_al
+};
diff --git a/arch/arm64/um/kprobe-trap.c b/arch/arm64/um/kprobe-trap.c
new file mode 100644
index 000000000..355a25be0
--- /dev/null
+++ b/arch/arm64/um/kprobe-trap.c
@@ -0,0 +1,125 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * kprobes 的 UML 陷入路由（ARCH=um SUBARCH=arm64）。
+ *
+ * 真机上 BRK 走 do_debug_exception() -> call_break_hook()，由 debug-monitors.c
+ * 按 ESR 里的 comment 把活儿分给父架构的三个 handler。UML 里内核文本就是本进程
+ * 可执行的代码，执行 BRK 只会得到宿主投来的 SIGTRAP，于是
+ * arch/um/os-Linux/signal.c 把该信号截住、整理成 x0..x30/sp/pc/pstate 交到这里：
+ * 本文件把 raw 数组翻译成 struct pt_regs + ESR，调用同一个 handler，再把 handler
+ * 改过的寄存器写回 raw，让宿主恢复执行时用的就是改过的状态。
+ */
+#include <linux/kallsyms.h>
+#include <linux/kprobes.h>
+#include <linux/sched.h>
+#include <linux/smp.h>
+#include <linux/string.h>
+#include <asm/brk-imm.h>
+#include <asm/debug-monitors.h>
+#include <asm/kprobes.h>
+#include <asm/ptrace.h>
+
+/*
+ * 父架构 <asm/esr.h> 会经 <asm/memory.h> 拉入真 arm64 的地址空间常量
+ * （CONFIG_ARM64_VA_BITS、virt_to_phys 等），UML 侧编不过。这里只用到两个
+ * ESR 编码常量，按 ARM ARM 的定义直接写。
+ */
+#define ESR_ELx_EC_SHIFT	26
+#define ESR_ELx_EC_BRK64	0x3c
+
+/*
+ * arm64 的 PSTATE 模式位。UML 的 <asm/ptrace.h> 不提供 PSR_MODE_*，
+ * 而这里只需要「内核态 EL1h」这一个值，按 ARM ARM 定义直接写。
+ */
+#define UM_PSR_MODE_MASK	0xful
+#define UM_PSR_MODE_EL1h	0x5ul
+
+/* raw[] 的布局，必须与 arch/arm64/um/os-Linux/kprobe-signal.c 一致 */
+enum {
+	UM_RAW_X0,
+	UM_RAW_SP = 31,
+	UM_RAW_PC,
+	UM_RAW_PSTATE,
+	UM_RAW_WORDS,
+};
+
+/* 每核防递归：kprobe 的 handler 自己再触发 BRK 时不再进入 */
+static int um_kprobe_busy[NR_CPUS];
+
+int um_arm64_kprobe_trap(unsigned long *raw)
+{
+	struct pt_regs regs;
+	unsigned long pc = raw[UM_RAW_PC];
+	unsigned long esr;
+	unsigned int insn;
+	int cpu, imm, ret, i;
+	bool ours;
+
+	cpu = raw_smp_processor_id();
+	if (um_kprobe_busy[cpu])
+		return 0;
+
+	if (!kernel_text_address(pc))
+		return 0;
+
+	insn = READ_ONCE(*(unsigned int *)pc);
+	if ((insn & 0xffe0001f) != AARCH64_BREAK_MON)
+		return 0;
+
+	imm = (insn >> 5) & 0xffff;
+	ours = (imm == KPROBES_BRK_IMM) || (imm == KPROBES_BRK_SS_IMM);
+#ifdef CONFIG_KRETPROBES
+	ours = ours || (imm == KRETPROBES_BRK_IMM);
+#endif
+	if (!ours)
+		return 0;
+
+	/*
+	 * UML 的 struct pt_regs 只有 regs.gp[] 一个寄存器阵列，没有 regs/sp/
+	 * pc/pstate/syscallno 这些成员，全部走 PT_REGS_* 宏。
+	 */
+	memset(&regs, 0, sizeof(regs));
+	for (i = 0; i < 31; i++)
+		PT_REGS_X(&regs, i) = raw[UM_RAW_X0 + i];
+	PT_REGS_SP_REG(&regs) = raw[UM_RAW_SP];
+	PT_REGS_IP(&regs) = pc;
+	/*
+	 * 这是内核态 BRK。UML 的 user_mode(regs) 读的是 uml_pt_regs.is_user
+	 * （memset 已置 0），真 arm64 读的是 pstate 模式位，所以这里把模式位
+	 * 也换成 EL1h，两边对「内核态」的判定才一致。宿主线程真正的 EL/DAIF
+	 * 由信号帧自己保存，这个改动不回写。
+	 */
+	PT_REGS_PSTATE(&regs) = (raw[UM_RAW_PSTATE] & ~UM_PSR_MODE_MASK) |
+				UM_PSR_MODE_EL1h;
+
+	esr = ((unsigned long)ESR_ELx_EC_BRK64 << ESR_ELx_EC_SHIFT) | imm;
+
+	um_kprobe_busy[cpu] = 1;
+	switch (imm) {
+	case KPROBES_BRK_IMM:
+		ret = kprobe_brk_handler(&regs, esr);
+		break;
+	case KPROBES_BRK_SS_IMM:
+		ret = kprobe_ss_brk_handler(&regs, esr);
+		break;
+#ifdef CONFIG_KRETPROBES
+	case KRETPROBES_BRK_IMM:
+		ret = kretprobe_brk_handler(&regs, esr);
+		break;
+#endif
+	default:
+		ret = 0;
+		break;
+	}
+	um_kprobe_busy[cpu] = 0;
+
+	if (!ret)
+		return 0;
+
+	for (i = 0; i < 31; i++)
+		raw[UM_RAW_X0 + i] = PT_REGS_X(&regs, i);
+	raw[UM_RAW_SP] = PT_REGS_SP_REG(&regs);
+	raw[UM_RAW_PC] = PT_REGS_IP(&regs);
+	return 1;
+}
+NOKPROBE_SYMBOL(um_arm64_kprobe_trap);
diff --git a/arch/arm64/um/kretprobe-trampoline.S b/arch/arm64/um/kretprobe-trampoline.S
new file mode 100644
index 000000000..80851a767
--- /dev/null
+++ b/arch/arm64/um/kretprobe-trampoline.S
@@ -0,0 +1,22 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * kretprobe trampoline for ARCH=um SUBARCH=arm64.
+ *
+ * 父架构的 kernel/probes/kprobes_trampoline.S 会 include <asm/assembler.h>，
+ * 那一串头在 UML 上是 C 专用的（alternative.h / cpufeature.h / ptrace.h 都有
+ * 汇编器不认识的写法），所以这里只留下真正需要的那一条 brk。
+ *
+ * kretprobe 把被 hook 函数的返回地址换成这个符号；执行到 brk 时宿主送来
+ * SIGTRAP，arch/um/os-Linux/signal.c 交给 kprobe-trap.c，后者合成 ESR 并转给
+ * kretprobe_brk_handler()，handler 把 PC 改成真实返回地址后再回到调用者。
+ *
+ * 立即数与父架构 asm/brk-imm.h 的 KRETPROBES_BRK_IMM 保持一致（0x007）。
+ */
+	.text
+	.align	2
+	.globl	__kretprobe_trampoline
+	.type	__kretprobe_trampoline, %function
+__kretprobe_trampoline:
+	brk	#0x007
+1:	b	1b
+	.size	__kretprobe_trampoline, . - __kretprobe_trampoline
