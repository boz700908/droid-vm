+/* ARCH=um SUBARCH=arm64 的 kprobes 桥；没有实现（如 x86）时是空指针 */
+extern int arch_um_kprobe_trap(mcontext_t *mc) __attribute__((weak));
+
 void (*sig_info[NSIG])(int, struct siginfo *, struct uml_pt_regs *, void *mc) = {
 	[SIGTRAP]	= relay_signal,
 	[SIGFPE]	= relay_signal,
@@ -48,6 +51,10 @@ static void sig_handler_common(int sig, struct siginfo *si, mcontext_t *mc)
 	if ((sig != SIGIO) && (sig != SIGWINCH) && (sig != SIGCHLD))
 		unblock_signals_trace();
 
+	/* BRK 型陷入：先交给 kprobes，没人认领才当普通信号转发给 guest */
+	if (sig == SIGTRAP && arch_um_kprobe_trap && arch_um_kprobe_trap(mc))
+		return;
+
 	(*sig_info[sig])(sig, si, &r, mc);
 }
 
