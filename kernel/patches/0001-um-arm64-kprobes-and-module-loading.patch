+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * ARCH=um SUBARCH=arm64 的 <asm/gcs.h>。
+ *
+ * GCS（Guarded Control Stack）是真 arm64 硬件特性，UML guest 没有，恒为未启用。
+ * 真头里有 .inst/sys 内联汇编并 include <asm/uaccess.h>（进而 <asm/memory.h>），
+ * 在 UML 上编不过；kernel/probes/simulate-insn.c 只用到下面三个入口。
+ */
+#ifndef __UM_ARM64_GCS_H
+#define __UM_ARM64_GCS_H
+
+struct task_struct;
+
+static inline bool task_gcs_el0_enabled(struct task_struct *task)
+{
+	return false;
+}
+
+static inline void push_user_gcs(unsigned long val, int *err) { }
+
+static inline u64 pop_user_gcs(int *err)
+{
+	*err = -EINVAL;
+	return 0;
+}
+
+#endif /* __UM_ARM64_GCS_H */
diff --git a/arch/arm64/um/asm/kprobes.h b/arch/arm64/um/asm/kprobes.h
index 511755ff8..fccbe1b7a 100644
--- a/arch/arm64/um/asm/kprobes.h
+++ b/arch/arm64/um/asm/kprobes.h
@@ -1,18 +1,24 @@
 /* SPDX-License-Identifier: GPL-2.0-only */
 /*
- * ARCH=um SUBARCH=arm64 has no kprobes.
+ * ARCH=um SUBARCH=arm64 的 <asm/kprobes.h>。
  *
- * arch/arm64/lib/insn.c is reused here for instruction encoding and tags some
- * of its functions __kprobes, which is a section annotation rather than a
- * dependency on the kprobes machinery. The generic header supplies it.
+ * 默认（CONFIG_KPROBES=n）只需要 __kprobes 这个段标注可用：arch/arm64/lib/insn.c
+ * 被复用来做指令编解码，里面的函数标了 __kprobes，那只是段标注，不依赖 kprobes
+ * 机制本身。而 arm64 的真头会经 asm/probes.h 牵出 cpufeature 一整套，白白拖进
+ * cpucap-defs.h，所以默认保持 asm-generic 的精简版。
  *
- * Without this, <asm/kprobes.h> resolves to arch/arm64's, which reaches
- * asm/cpucaps.h and the generated asm/cpucap-defs.h -- the whole cpufeature
- * apparatus -- to obtain a macro that expands to nothing here.
+ * CONFIG_KPROBES=y 时反过来必须用父架构的完整定义：kprobe_opcode_t、
+ * MAX_INSN_SIZE、struct arch_specific_insn、struct kprobe_ctlblk，以及
+ * kprobe_brk_handler()/kprobe_ss_brk_handler()/kretprobe_brk_handler() 的原型
+ * 都在 arch/arm64/include/asm/kprobes.h 里。UML 换的只是陷入入口，其余照用。
  */
 #ifndef __UM_ARM64_KPROBES_H
 #define __UM_ARM64_KPROBES_H
 
+#if defined(CONFIG_KPROBES) && defined(__aarch64__)
+#include "../../include/asm/kprobes.h"
+#else
 #include <asm-generic/kprobes.h>
+#endif
 
 #endif /* __UM_ARM64_KPROBES_H */
diff --git a/arch/arm64/um/asm/ptrace.h b/arch/arm64/um/asm/ptrace.h
index 8a773c44c..586217381 100644
--- a/arch/arm64/um/asm/ptrace.h
+++ b/arch/arm64/um/asm/ptrace.h
@@ -101,4 +101,37 @@ static inline int ptrace_set_thread_area(struct task_struct *child, int idx,
 
 extern void arch_switch_to(struct task_struct *to);
 
+
+/*
+ * generic kernel/kprobes.c（UP 分支）与 arch/arm64/kernel/probes/kprobes.c
+ * 都要把 PC 写回 pt_regs；UML 的 ptrace-generic.h 只提供了读宏。
+ */
+#ifndef instruction_pointer_set
+#define instruction_pointer_set(regs, val) (PT_REGS_IP(regs) = (val))
+#endif
+
+#ifndef __ASSEMBLY__
+/*
+ * 父架构的 kernel/probes/simulate-insn.c 按「架构寄存器号」读写 pt_regs，其中
+ * 31 表示 XZR 而不是 SP；UML 侧 x0..x30 与 HOST_Xn 一一对应且连续。
+ */
+static inline unsigned long pt_regs_read_reg(struct pt_regs *regs, int r)
+{
+	return (r == 31) ? 0 : PT_REGS_X(regs, r);
+}
+
+static inline void pt_regs_write_reg(struct pt_regs *regs, int r,
+				     unsigned long val)
+{
+	if (r != 31)
+		PT_REGS_X(regs, r) = val;
+}
+
+static inline void procedure_link_pointer_set(struct pt_regs *regs,
+					      unsigned long val)
+{
+	PT_REGS_X30(regs) = val;
+}
+#endif /* !__ASSEMBLY__ */
+
 #endif /* __UM_ARM64_PTRACE_H */
diff --git a/arch/arm64/um/asm/traps.h b/arch/arm64/um/asm/traps.h
new file mode 100644
