diff --git a/arch/um/os-Linux/signal.c b/arch/um/os-Linux/signal.c
index de372b936..4ae327acd 100644
--- a/arch/um/os-Linux/signal.c
+++ b/arch/um/os-Linux/signal.c
@@ -22,6 +22,9 @@
